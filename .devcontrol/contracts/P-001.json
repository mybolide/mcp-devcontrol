{
  "pathId": "P-001",
  "requirementId": "FR-001",
  "allowedPaths": [
    "."
  ],
  "allowNewFiles": false,
  "testCmds": [
    "npm test",
    "npm run build",
    "npm run packcheck"
  ],
  "budgetLines": 1200,
  "standards": {
    "enforced": [
      "scope"
    ],
    "rules": [
      {
        "id": "scope",
        "text": "只改任务 scope 内的文件；新增文件也要落在 scope 内",
        "enforced": true
      },
      {
        "id": "budget",
        "text": "单个任务改动不超过 1200 行；超了通常是该拆任务"
      },
      {
        "id": "tests",
        "text": "不动依赖与既有测试；新增测试文件不受限（TDD 是正常动作）"
      },
      {
        "id": "testconf",
        "text": "不动测试配置（runner、覆盖率阈值之类）"
      },
      {
        "id": "todo",
        "text": "不留 TODO / FIXME / HACK 标记；要记就记进任务标题或 issue"
      }
    ]
  },
  "note": "批准时冻结；Agent 只读，改动必须由 Owner 重新批准"
}
